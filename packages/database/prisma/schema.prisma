generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
  SUSPENDED
}

enum TrekLevel {
  GUIDE
  LEADER
  MOUNTAINEER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TrekStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  CANCELLED
}

enum PackageVisibility {
  PUBLIC
  PRIVATE
}

enum ScheduleStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum LocationType {
  COUNTRY
  STATE
  DISTRICT
  SUBDISTRICT
  URBAN_LOCAL_BODY
}

model User {
  id        String  @id @map("_id")
  googleId  String  @unique
  email     String  @unique
  name      String?
  avatarUrl String?

  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  isDeleted Boolean    @default(false)

  trekLevel       TrekLevel @default(GUIDE)
  experienceYears Int       @default(0)
  phone           String?
  bio             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  userExperiences    UserExperience[]
  userCertifications UserCertification[]
  userBadges         UserBadge[]
  masterTreks        MasterTrek[]
  packages           Package[]
  packageBookings    PackageBooking[]
}

model Session {
  id               String   @id @map("_id")
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserExperience {
  id     String @id @map("_id")
  userId String

  trekName           String
  difficulty         Difficulty
  roleDuringTrek     String
  completedAt        DateTime
  duration           Int
  altitude           Float?
  proofUrl           String?
  verificationStatus String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCertification {
  id     String @id @map("_id")
  userId String

  title               String
  issuingOrganization String
  certificateNumber   String?
  certificateUrl      String
  issuedAt            DateTime
  expiresAt           DateTime?
  verificationStatus  String
  verifiedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String  @id @map("_id")
  name        String  @unique
  description String
  iconUrl     String?
  criteria    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @map("_id")
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Location {
  id   String       @id @map("_id")
  name String
  type LocationType

  sourceCode    String
  localBodyType String?

  parentId String?

  parent Location? @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  children Location[] @relation("LocationHierarchy")

  masterTreks  MasterTrek[]
  nearbyPlaces NearbyPlace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterTrek {
  id String @id @map("_id")

  name             String
  slug             String  @unique
  shortDescription String?
  description      String
  tagline          String?

  difficulty     Difficulty
  durationDays   Int
  maxAltitude    Float?
  distanceKm     Float?
  distinctRoutes Int        @default(1)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  latitude   Float?
  longitude  Float?

  bestSeason       String?
  beginnerFriendly Boolean @default(false)

  overview           String?
  howToReach         String?
  fitnessInfo        String?
  safetyInfo         String?
  permitInfo         String?
  sustainabilityInfo String?

  coverImageUrl String?
  videoUrl      String?
  galleryImages String[]

  status TrekStatus @default(DRAFT)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  routes       TrekRoute[]
  nearbyPlaces TrekNearbyPlace[]

  activityIds String[]
  activities  Activity[] @relation(fields: [activityIds], references: [id])

  packages Package[]
  faqs     MasterTrekFaq[]
}

model MasterTrekFaq {
  id           String @id @map("_id")
  masterTrekId String

  question String
  answer   String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterTrek MasterTrek @relation(fields: [masterTrekId], references: [id], onDelete: Cascade)
}

model TrekRoute {
  id           String @id @map("_id")
  masterTrekId String

  name        String
  description String?

  distanceKm    Float?
  difficulty    Difficulty?
  elevationGain Float?
  ascentTime    String?
  descentTime   String?

  startPoint String?
  endPoint   String?

  isPopular Boolean @default(false)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterTrek    MasterTrek         @relation(fields: [masterTrekId], references: [id], onDelete: Cascade)
  itineraryDays TrekItineraryDay[]
  packages      Package[]
}

model TrekItineraryDay {
  id      String @id @map("_id")
  routeId String

  dayNumber   Int
  title       String
  description String?

  startLocation String?
  endLocation   String?

  distanceKm Float?
  duration   String?
  altitude   Float?

  imageUrls String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route TrekRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  activityIds String[]
  activities  Activity[] @relation(fields: [activityIds], references: [id])
}

model Activity {
  id          String  @id @map("_id")
  name        String  @unique
  description String?
  iconUrl     String?

  trekIds String[]
  treks   MasterTrek[] @relation(fields: [trekIds], references: [id])

  itineraryDayIds String[]
  itineraryDays   TrekItineraryDay[] @relation(fields: [itineraryDayIds], references: [id])

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  packageItineraryDayIds String[]
  packageItineraryDays   PackageItineraryDay[] @relation(fields: [packageItineraryDayIds], references: [id])
}

model NearbyPlace {
  id String @id @map("_id")

  name        String
  description String?
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  latitude    Float?
  longitude   Float?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trekLinks TrekNearbyPlace[]
}

model TrekNearbyPlace {
  id String @id @map("_id")

  trekId        String
  nearbyPlaceId String

  distanceFromTrek Float?
  travelTime       String?

  trek        MasterTrek  @relation(fields: [trekId], references: [id], onDelete: Cascade)
  nearbyPlace NearbyPlace @relation(fields: [nearbyPlaceId], references: [id], onDelete: Cascade)

  @@unique([trekId, nearbyPlaceId])
}

model Package {
  id String @id @map("_id")

  createdByUserId String
  masterTrekId    String
  routeId         String

  title       String
  description String?
  visibility  PackageVisibility @default(PUBLIC)
  status      PackageStatus     @default(DRAFT)

  minParticipants Int?
  maxParticipants Int?
  meetingPoint    String?
  instructions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  User       @relation(fields: [createdByUserId], references: [id])
  masterTrek MasterTrek @relation(fields: [masterTrekId], references: [id])
  route      TrekRoute  @relation(fields: [routeId], references: [id])

  itineraryDays PackageItineraryDay[]
  schedules     PackageSchedule[]
}

model PackageItineraryDay {
  id        String @id @map("_id")
  packageId String

  dayNumber   Int
  title       String
  description String?

  startLocation String?
  endLocation   String?
  distanceKm    Float?
  duration      String?
  altitude      Float?

  activityIds String[]
  activities  Activity[] @relation(fields: [activityIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model PackageSchedule {
  id        String @id @map("_id")
  packageId String

  startDate DateTime
  endDate   DateTime

  bookingStartDate DateTime?
  bookingEndDate   DateTime?

  price    Float
  currency String @default("INR")

  capacity       Int
  availableSeats Int

  status             ScheduleStatus @default(DRAFT)
  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package  Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings PackageBooking[]
}

model PackageBooking {
  id         String @id @map("_id")
  userId     String
  scheduleId String

  status BookingStatus @default(PENDING)

  bookedAt           DateTime  @default(now())
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  schedule PackageSchedule @relation(fields: [scheduleId], references: [id])

  payments Payment[]

  @@unique([userId, scheduleId])
}

model Payment {
  id        String @id @map("_id")
  bookingId String

  amount   Float
  currency String @default("INR")

  paymentGateway   String?
  gatewayOrderId   String?
  gatewayPaymentId String?

  status PaymentStatus @default(PENDING)

  paidAt       DateTime?
  failedAt     DateTime?
  refundedAt   DateTime?
  refundAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking PackageBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
